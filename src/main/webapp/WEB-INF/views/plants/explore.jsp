<%@ page contentType="text/html;charset=UTF-8" %>
<%@ include file="../common/header.jspf" %>
<section class="page-intro compact"><p class="eyebrow">PLANTSCOPE / DESCRIBE WHAT YOU SEE</p><h1>描述你看到的植物</h1><p>输入名称或日常描述。系统只使用有限的同义词与规则提取特征；它不是 AI，也不代表物种识别结论。</p></section>
<form class="description-search-form" method="get" action="${pageContext.request.contextPath}/discover" data-validate="description" novalidate>
  <label for="plant-description">植物名称或外观描述</label><textarea id="plant-description" name="q" maxlength="500" rows="3" placeholder="例如：叶子很细像针，树上长着棕色松塔。秋天叶片会变黄，形状像小扇子。"><c:out value="${query}"/></textarea><c:if test="${not empty sessionScope.currentUser}"><label class="history-opt-in"><input type="checkbox" name="saveSearch" value="1" <c:if test="${param.saveSearch eq '1'}">checked</c:if>> 保存此次检索到我的历史</label></c:if>
  <div class="description-form-foot"><small>最多 500 个字符。可只描述一个特征。</small><button class="button primary" type="submit" data-loading-text="正在整理特征…">开始探索</button></div>
</form>
<c:if test="${not empty parsed}"><section class="parsed-description" aria-live="polite"><h2>系统提取到的特征</h2><c:choose><c:when test="${not empty recognizedTerms}"><p><c:forEach items="${recognizedTerms}" var="term"><span class="parsed-chip"><c:out value="${term}"/></span></c:forEach></p><p class="muted">以下条件可以修改；提取仅来自词典和规则匹配。</p></c:when><c:otherwise><p>没有识别出支持的特征词。可以换一种说法，或按名称搜索。</p></c:otherwise></c:choose><c:if test="${not empty parseWarnings}"><ul class="parse-warnings"><c:forEach items="${parseWarnings}" var="warning"><li><c:out value="${warning}"/></li></c:forEach></ul></c:if></section></c:if>
<c:if test="${not empty traits and mode eq 'traits'}"><section class="manual-correction"><h2>检查或修正条件</h2><p>可更改提取值、标记确定不符合的特征，或添加其他条件后重新查询。</p><%@ include file="trait-selectors.jspf" %></section></c:if>
<c:if test="${not empty error}"><div class="notice warning" role="status"><c:out value="${error}"/></div></c:if>
<c:if test="${mode eq 'traits'}">
  <c:choose><c:when test="${empty pageData.items}"><section class="empty-state trait-empty"><h2>不足以可靠判断</h2><p>没有找到带有已核验匹配特征的公开植物记录。未知、待核验或有争议的信息不会被当作匹配或冲突。你可以保留这些条件稍后再试，或打开植物名录。</p><a class="button secondary" href="${pageContext.request.contextPath}/plants">浏览植物名录</a></section></c:when>
  <c:otherwise><section class="match-results"><div class="section-heading"><div><p class="eyebrow">DATABASE-BACKED CANDIDATES</p><h2>可能的植物</h2></div><p><c:out value="${pageData.total}"/> 个候选</p></div><p class="match-caveat">匹配分数与覆盖度是两个独立指标；分数不等于真实识别准确率。</p><div class="candidate-list"><c:forEach items="${pageData.items}" var="candidate"><article class="candidate-card"><a class="candidate-image" href="${pageContext.request.contextPath}/plant?id=${candidate.plantId}"><c:choose><c:when test="${not empty candidate.imageStoredName}"><img src="${pageContext.request.contextPath}/image/${candidate.imageStoredName}" alt="" loading="lazy"></c:when><c:otherwise><span aria-hidden="true">✳</span></c:otherwise></c:choose></a><div class="candidate-body"><p class="candidate-taxonomy"><c:out value="${candidate.familyZh}" default="科名待补"/> · <c:out value="${candidate.genusZh}" default="属名待补"/></p><h3><a href="${pageContext.request.contextPath}/plant?id=${candidate.plantId}"><c:out value="${candidate.nameZh}"/></a></h3><i><c:out value="${candidate.scientificName}" default="学名待核验"/></i><div class="candidate-score"><strong>匹配分数 <c:out value="${candidate.matchScore}"/> / 100</strong><span>数据覆盖 <c:out value="${candidate.dataCoverage}"/>%</span><c:if test="${not candidate.enoughEvidence}"><b class="insufficient-tag">不足以可靠判断</b></c:if></div><div class="evidence-columns"><div><b>匹配依据</b><ul><c:forEach items="${candidate.matches}" var="why"><li><c:out value="${why}"/></li></c:forEach></ul></div><c:if test="${not empty candidate.conflicts}"><div><b>明确不匹配</b><ul><c:forEach items="${candidate.conflicts}" var="why"><li><c:out value="${why}"/></li></c:forEach></ul></div></c:if><c:if test="${not empty candidate.unknowns}"><div><b>未知或待核验</b><ul><c:forEach items="${candidate.unknowns}" var="why"><li><c:out value="${why}"/></li></c:forEach></ul></div></c:if></div><a class="text-link" href="${pageContext.request.contextPath}/plant?id=${candidate.plantId}">查看详情 →</a></div></article></c:forEach></div></section></c:otherwise></c:choose>
</c:if>
<c:if test="${mode eq 'names'}"><section class="search-results"><div class="results-head"><div><p class="eyebrow">NAME SEARCH</p><h2>名称检索结果</h2></div><p>数据库记录 <b><c:out value="${pageData.total}"/></b> 条</p></div><c:choose><c:when test="${empty pageData.items}"><div class="empty-state"><h2>没有找到植物名称</h2><p>尝试别名、中文名或拉丁学名，也可以描述外观特征。</p></div></c:when><c:otherwise><div class="candidate-list name-candidate-list"><c:forEach items="${pageData.items}" var="plant"><article class="candidate-card"><a class="candidate-image" href="${pageContext.request.contextPath}/plant?id=${plant.id}"><c:choose><c:when test="${not empty plant.imageStoredName}"><img src="${pageContext.request.contextPath}/image/${plant.imageStoredName}" alt="" loading="lazy"></c:when><c:otherwise><span aria-hidden="true">✳</span></c:otherwise></c:choose></a><div class="candidate-body"><p class="candidate-taxonomy"><c:out value="${plant.familyZh}" default="科名待补"/> · <c:out value="${plant.genusZh}" default="属名待补"/></p><h3><a href="${pageContext.request.contextPath}/plant?id=${plant.id}"><c:out value="${plant.nameZh}"/></a></h3><i><c:out value="${plant.scientificName}" default="学名待核验"/></i><p><c:out value="${plant.morphology}" default="暂无形态描述"/></p></div></article></c:forEach></div></c:otherwise></c:choose></section></c:if>
<section class="discover-shortcuts"><a class="button secondary" href="${pageContext.request.contextPath}/find-by-traits">按外观特征筛选</a><a class="text-link" href="${pageContext.request.contextPath}/search/advanced">专业数据检索 →</a></section>
<%@ include file="../common/footer.jspf" %>
