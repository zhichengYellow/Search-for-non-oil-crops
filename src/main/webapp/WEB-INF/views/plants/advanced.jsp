<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %><section class="page-intro compact"><p class="eyebrow">COMBINED QUERY</p><h1>高级查询</h1><p>筛选条件默认采用 AND 关系；含油率和化学组分必须匹配同一条采样记录。</p></section><c:if test="${empty sessionScope.currentUser}"><div class="notice warning">基础查询可供游客使用。登录后可使用组合条件和自定义结果字段。 <a href="${pageContext.request.contextPath}/login">登录</a></div></c:if><form class="query-panel" method="get" action="${pageContext.request.contextPath}/search/advanced" data-validate="ranges" data-search-form novalidate><div class="query-grid"><label>科名<input name="family" maxlength="100" value="<c:out value='${param.family}'/>" placeholder="如：输入科名"></label><label>属名<input name="genus" maxlength="120" value="<c:out value='${param.genus}'/>" placeholder="中文属名或拉丁属名"></label><label>中文名称<input name="nameZh" maxlength="160" value="<c:out value='${param.nameZh}'/>"></label><label>拉丁学名<input name="scientificName" maxlength="220" value="<c:out value='${param.scientificName}'/>"></label><label>用途关键词<input name="uses" maxlength="160" value="<c:out value='${param.uses}'/>"></label><label>分布关键词<input name="distribution" maxlength="160" value="<c:out value='${param.distribution}'/>"></label><div class="range-field"><span>含油率范围（%）</span><div><input name="oilMin" type="number" min="0" max="100" step="0.001" value="<c:out value='${param.oilMin}'/>" placeholder="最小"><b>—</b><input name="oilMax" type="number" min="0" max="100" step="0.001" value="<c:out value='${param.oilMax}'/>" placeholder="最大"></div></div><label>化学组分名称<input name="component" maxlength="120" value="<c:out value='${param.component}'/>" placeholder="如：油酸"></label><div class="range-field"><span>组分含量范围（%）</span><div><input name="componentMin" type="number" min="0" max="100" step="0.001" value="<c:out value='${param.componentMin}'/>" placeholder="最小"><b>—</b><input name="componentMax" type="number" min="0" max="100" step="0.001" value="<c:out value='${param.componentMax}'/>" placeholder="最大"></div></div><label>排序方式<select name="sort"><option value="name">中文名</option><option value="oilContent" <c:if test="${param.sort eq 'oilContent'}">selected</c:if>>含油率</option></select></label><label>排序顺序<select name="direction"><option value="asc">升序</option><option value="desc" <c:if test="${param.direction eq 'desc'}">selected</c:if>>降序</option></select></label></div><p class="field-hint" data-range-message role="status"></p><p class="filter-change-status" data-filter-status role="status" aria-live="polite"></p><fieldset class="result-fieldset"><legend>结果显示字段</legend><div class="result-field-options"><c:forEach items="${['image','nameZh','scientificName','family','genus','distribution','uses','oilContent']}" var="field"><label><input type="checkbox" name="field" value="${field}" <c:if test="${fields.contains(field)}">checked</c:if>><c:choose><c:when test="${field eq 'image'}">图片</c:when><c:when test="${field eq 'nameZh'}">中文名称</c:when><c:when test="${field eq 'scientificName'}">拉丁学名</c:when><c:when test="${field eq 'family'}">科</c:when><c:when test="${field eq 'genus'}">属</c:when><c:when test="${field eq 'distribution'}">分布</c:when><c:when test="${field eq 'uses'}">用途</c:when><c:otherwise>含油率</c:otherwise></c:choose></label></c:forEach></div><button class="link-button" type="button" data-select-fields="all">全选</button><button class="link-button" type="button" data-select-fields="default">恢复默认</button></fieldset><div class="query-actions"><button class="button primary" type="submit" data-loading-text="正在查询…">运行查询 <span>↗</span></button><a class="button secondary" href="${pageContext.request.contextPath}/search/advanced">清除条件</a></div></form><c:if test="${not empty pageData}"><section class="results-head"><div><h2>查询结果</h2><p>共 <b><c:out value="${pageData.total}"/></b> 条记录</p></div><span class="muted">按 <c:out value="${criteria.sort}"/> 排序</span></section><c:choose><c:when test="${empty pageData.items}"><div class="empty-state"><h3>没有符合条件的植物</h3><p>放宽范围或减少筛选条件后重试。</p></div></c:when><c:otherwise><div class="plant-grid compact-grid"><c:forEach items="${pageData.items}" var="p"><a class="plant-card" href="${pageContext.request.contextPath}/plant?id=${p.id}"><c:if test="${fields.contains('image')}"><div class="plant-card-image"><c:choose><c:when test="${not empty p.imageStoredName}"><img src="${pageContext.request.contextPath}/image/${p.imageStoredName}" alt=""></c:when><c:otherwise><div class="image-placeholder">✳</div></c:otherwise></c:choose></div></c:if><div class="plant-card-body"><c:if test="${fields.contains('family') or fields.contains('genus')}"><span class="taxonomy"><c:if test="${fields.contains('family')}"><c:out value="${p.familyZh}" default="暂无科名"/></c:if><c:if test="${fields.contains('family') and fields.contains('genus')}"> · </c:if><c:if test="${fields.contains('genus')}"><c:out value="${p.genusZh}" default="暂无属名"/></c:if></span></c:if><c:if test="${fields.contains('nameZh')}"><h3><c:out value="${p.nameZh}"/></h3></c:if><c:if test="${fields.contains('scientificName')}"><i><c:out value="${p.scientificName}" default="暂无学名"/></i></c:if><c:if test="${fields.contains('distribution')}"><p class="result-text"><c:out value="${p.distribution}" default="暂无分布信息"/></p></c:if><c:if test="${fields.contains('uses')}"><p class="result-text"><c:out value="${p.uses}" default="暂无用途信息"/></p></c:if><c:if test="${fields.contains('oilContent')}"><span class="result-oil"><c:out value="${p.oilContentSummary}" default="暂无数据"/></span></c:if></div></a></c:forEach></div></c:otherwise></c:choose><c:if test="${pageData.totalPages gt 1}"><form method="get" action="${pageContext.request.contextPath}/search/advanced" class="pagination-form"><input type="hidden" name="family" value="<c:out value='${param.family}'/>"><input type="hidden" name="genus" value="<c:out value='${param.genus}'/>"><input type="hidden" name="nameZh" value="<c:out value='${param.nameZh}'/>"><input type="hidden" name="scientificName" value="<c:out value='${param.scientificName}'/>"><input type="hidden" name="uses" value="<c:out value='${param.uses}'/>"><input type="hidden" name="distribution" value="<c:out value='${param.distribution}'/>"><input type="hidden" name="oilMin" value="<c:out value='${param.oilMin}'/>"><input type="hidden" name="oilMax" value="<c:out value='${param.oilMax}'/>"><input type="hidden" name="component" value="<c:out value='${param.component}'/>"><input type="hidden" name="componentMin" value="<c:out value='${param.componentMin}'/>"><input type="hidden" name="componentMax" value="<c:out value='${param.componentMax}'/>"><input type="hidden" name="sort" value="<c:out value='${param.sort}'/>"><input type="hidden" name="direction" value="<c:out value='${param.direction}'/>"><c:forEach items="${fields}" var="field"><input type="hidden" name="field" value="${field}"></c:forEach><c:if test="${pageData.page gt 1}"><button class="link-button" name="page" value="${pageData.page-1}">← 上一页</button></c:if><span>第 <c:out value="${pageData.page}"/> / <c:out value="${pageData.totalPages}"/> 页</span><c:if test="${pageData.page lt pageData.totalPages}"><button class="link-button" name="page" value="${pageData.page+1}">下一页 →</button></c:if></form></c:if></c:if><%@ include file="../common/footer.jspf" %>
