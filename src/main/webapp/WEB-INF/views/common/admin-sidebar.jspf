<%@ page pageEncoding="UTF-8" %>
<aside class="admin-sidebar" aria-label="管理控制台导航">
  <div class="admin-sidebar-heading"><p class="eyebrow">CURATION DESK</p><h2>资料管理</h2><span>植物科学知识库</span></div>
  <nav class="admin-side-nav" aria-label="管理功能">
    <a href="${pageContext.request.contextPath}/admin" class="${adminSection eq 'dashboard' ? 'active' : ''}" <c:if test="${adminSection eq 'dashboard'}">aria-current="page"</c:if>><span aria-hidden="true">◫</span>概览</a>
    <a href="${pageContext.request.contextPath}/admin/plants" class="${adminSection eq 'plants' ? 'active' : ''}" <c:if test="${adminSection eq 'plants'}">aria-current="page"</c:if>><span aria-hidden="true">❧</span>植物资料</a>
    <a href="${pageContext.request.contextPath}/admin/traits" class="${adminSection eq 'traits' ? 'active' : ''}" <c:if test="${adminSection eq 'traits'}">aria-current="page"</c:if>><span aria-hidden="true">◈</span>外观特征与来源</a>
    <a href="${pageContext.request.contextPath}/admin/categories" class="${adminSection eq 'categories' ? 'active' : ''}" <c:if test="${adminSection eq 'categories'}">aria-current="page"</c:if>><span aria-hidden="true">⌘</span>科属分类</a>
    <a href="${pageContext.request.contextPath}/admin/users" class="${adminSection eq 'users' ? 'active' : ''}" <c:if test="${adminSection eq 'users'}">aria-current="page"</c:if>><span aria-hidden="true">◎</span>用户管理</a>
  </nav>
  <a class="admin-return" href="${pageContext.request.contextPath}/">← 返回知识库</a>
</aside>
