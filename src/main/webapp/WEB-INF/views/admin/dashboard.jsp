<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<c:set var="adminSection" value="dashboard"/>
<div class="admin-workspace">
  <%@ include file="../common/admin-sidebar.jspf" %>
  <div class="admin-content"><section class="page-intro admin-intro"><p class="eyebrow">CURATION DESK / OVERVIEW</p><h1>管理控制台</h1><p>维护植物条目、分类和资料核验状态。</p></section><div class="stat-grid"><article class="stat-card"><span>植物条目</span><strong><c:out value="${plantCount}"/></strong><small>当前数据库中的植物总数</small></article><article class="stat-card accent-stat"><span>待核验条目</span><strong><c:out value="${reviewCount}"/></strong><small>需要回看来源与证据</small></article><article class="stat-card"><span>注册用户</span><strong><c:out value="${users}"/></strong><small>含管理员账户</small></article></div>
    <section class="section-block quality-dashboard"><div class="section-heading"><div><p class="eyebrow">DATA QUALITY / LIVE DATABASE</p><h2>数据质量概况</h2><p>下列统计由当前数据库实时计算；候选记录不会计入已确认数据。</p></div></div><dl class="quality-metric-grid"><div><dt>有已核验含油率的样本</dt><dd><c:out value="${qualityMetrics.verified_oil_samples}"/> / <c:out value="${qualityMetrics.oil_samples}"/></dd></div><div><dt>至少有一条已核验油率的植物</dt><dd><c:out value="${qualityMetrics.plants_with_verified_oil}"/> / <c:out value="${qualityMetrics.plants}"/></dd></div><div><dt>待审核外观特征候选</dt><dd><c:out value="${qualityMetrics.trait_candidates_pending}"/></dd></div><div><dt>有已确认特征的植物</dt><dd><c:out value="${qualityMetrics.plants_with_confirmed_traits}"/> / <c:out value="${qualityMetrics.plants}"/></dd></div><div><dt>待审核脂肪酸候选单元格</dt><dd><c:out value="${qualityMetrics.fatty_acid_candidates_pending}"/></dd></div><div><dt>已核验脂肪酸组分</dt><dd><c:out value="${qualityMetrics.fatty_acids_verified}"/></dd></div><div><dt>待审外部分类候选</dt><dd><c:out value="${qualityMetrics.external_candidates_pending}"/></dd></div><div><dt>知识审核事件</dt><dd><c:out value="${qualityMetrics.review_events}"/></dd></div></dl></section>
    <section class="section-block admin-shortcuts"><div class="section-heading"><div><p class="eyebrow">CURATION TOOLS</p><h2>数据管理</h2></div></div><div class="shortcut-grid"><a href="${pageContext.request.contextPath}/admin/plants/form" class="shortcut"><span>＋</span><div><b>新增植物</b><small>记录分类、形态、来源和样本</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/plants" class="shortcut"><span>⌕</span><div><b>管理植物名录</b><small>查看、修改或删除已有条目</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/expansion" class="shortcut"><span>↗</span><div><b>扩容审核</b><small>检查外部来源、待审候选和导入批次</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/traits" class="shortcut"><span>◈</span><div><b>审核外观特征</b><small>查看 PDF 证据与待核验特征</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/fatty-acids" class="shortcut"><span>∿</span><div><b>审核脂肪酸</b><small>复核样品、单位及原始表格</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/categories" class="shortcut"><span>⌘</span><div><b>科属信息</b><small>维护分类体系</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/users" class="shortcut"><span>◎</span><div><b>用户管理</b><small>查看账户及状态</small></div><i>↗</i></a></div></section><section class="section-block"><div class="section-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>最近变更</h2></div></div><c:choose><c:when test="${empty logs}"><div class="empty-inline">尚无管理操作记录</div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>操作</th><th>类型</th><th>记录 ID</th><th>说明</th><th>操作人</th><th>时间</th></tr></thead><tbody><c:forEach items="${logs}" var="log"><tr><c:forEach items="${log}" var="cell"><td><c:out value="${cell}" default="—"/></td></c:forEach></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></div>
</div>
<%@ include file="../common/footer.jspf" %>
