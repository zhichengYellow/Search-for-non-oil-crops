<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<c:set var="adminSection" value="dashboard"/>
<div class="admin-workspace">
  <%@ include file="../common/admin-sidebar.jspf" %>
  <div class="admin-content"><section class="page-intro admin-intro"><p class="eyebrow">CURATION DESK / OVERVIEW</p><h1>管理控制台</h1><p>维护植物条目、分类和资料核验状态。</p></section><div class="stat-grid"><article class="stat-card"><span>植物条目</span><strong><c:out value="${plantCount}"/></strong><small>当前数据库中的植物总数</small></article><article class="stat-card accent-stat"><span>待核验条目</span><strong><c:out value="${reviewCount}"/></strong><small>需要回看来源与证据</small></article><article class="stat-card"><span>注册用户</span><strong><c:out value="${users}"/></strong><small>含管理员账户</small></article></div><section class="section-block admin-shortcuts"><div class="section-heading"><div><p class="eyebrow">CURATION TOOLS</p><h2>数据管理</h2></div></div><div class="shortcut-grid"><a href="${pageContext.request.contextPath}/admin/plants/form" class="shortcut"><span>＋</span><div><b>新增植物</b><small>记录分类、形态、来源和样本</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/plants" class="shortcut"><span>⌕</span><div><b>管理植物名录</b><small>查看、修改或删除已有条目</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/categories" class="shortcut"><span>⌘</span><div><b>科属信息</b><small>维护分类体系</small></div><i>↗</i></a><a href="${pageContext.request.contextPath}/admin/users" class="shortcut"><span>◎</span><div><b>用户管理</b><small>查看账户及状态</small></div><i>↗</i></a></div></section><section class="section-block"><div class="section-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>最近变更</h2></div></div><c:choose><c:when test="${empty logs}"><div class="empty-inline">尚无管理操作记录</div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>操作</th><th>类型</th><th>记录 ID</th><th>说明</th><th>操作人</th><th>时间</th></tr></thead><tbody><c:forEach items="${logs}" var="log"><tr><c:forEach items="${log}" var="cell"><td><c:out value="${cell}" default="—"/></td></c:forEach></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></div>
</div>
<%@ include file="../common/footer.jspf" %>
