<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ include file="../common/header.jspf" %>
<section class="admin-workspace"><%@ include file="../common/admin-sidebar.jspf" %><div class="admin-content">
  <section class="page-intro admin-intro"><p class="eyebrow">EXTERNAL TAXONOMY / GBIF</p><h1>外部分类候选审核</h1><p>按需调用 GBIF Species API v2 的严格名称匹配。结果作为待审候选保存；确认或拒绝都不会自动覆盖课程资料中的植物名称与分类。</p></section>
  <c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
  <section class="inner-panel"><div class="section-heading"><div><p class="eyebrow">ON-DEMAND MATCH</p><h2>查找分类候选</h2></div></div>
    <form method="post" action="${pageContext.request.contextPath}/admin/taxa" class="editor-fields source-fields" data-validate="gbif-lookup" novalidate><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="lookup"><label for="gbif-plant">本地植物</label><select id="gbif-plant" name="plantId" required><option value="">选择植物</option><c:forEach items="${plants}" var="plant"><option value="${plant.id}"><c:out value="${plant.nameZh}"/> — <c:out value="${plant.scientificName}" default="学名缺失"/></option></c:forEach></select><p class="muted">接口请求按需触发，服务器全局最短间隔 5 秒。GBIF 返回的匹配置信度是名称匹配诊断值，不是植物事实真实性。</p><div class="editor-actions"><button class="button secondary" type="submit">查询 GBIF 候选</button></div></form>
  </section>
  <section class="inner-panel trait-values-list"><div class="admin-table-heading"><p><b><c:out value="${fn:length(taxonCandidates)}"/></b> 条待审核匹配（最多显示 100 条）</p></div><div class="table-wrap"><table class="data-table"><thead><tr><th>本地资料</th><th>GBIF 返回</th><th>诊断</th><th>审核决定</th></tr></thead><tbody>
    <c:forEach items="${taxonCandidates}" var="candidate"><tr><td><b><c:out value="${candidate.plantName}"/></b><small><i><c:out value="${candidate.localScientificName}"/></i></small></td><td><c:out value="${candidate.matchedName}"/><small>接受名：<c:out value="${candidate.acceptedName}"/></small><small>rank=<c:out value="${candidate.taxonRank}"/> · key=<c:out value="${candidate.taxonKey}"/></small><small>查询名：<c:out value="${candidate.queryName}"/></small></td><td><c:out value="${candidate.matchConfidence}"/> / 100<small><c:out value="${candidate.sourceName}"/> · <c:out value="${candidate.retrievedAt}"/></small><span class="table-status"><c:out value="${candidate.status}"/></span></td><td><form method="post" action="${pageContext.request.contextPath}/admin/taxa" data-validate="taxon-review" novalidate><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${candidate.id}"><label class="visually-hidden" for="review-reason-${candidate.id}">分类候选审核说明</label><input id="review-reason-${candidate.id}" name="reason" minlength="8" maxlength="2000" required placeholder="审核依据（至少 8 字符）"><div class="editor-actions"><button class="button primary" name="action" value="confirm" type="submit">确认匹配</button><button class="button danger" name="action" value="reject" type="submit">拒绝</button></div></form><small>确认仅记录匹配审查，不更改植物条目。</small></td></tr></c:forEach>
    <c:if test="${empty taxonCandidates}"><tr><td colspan="4">尚无外部分类候选。</td></tr></c:if>
  </tbody></table></div></section>
  <p class="muted">GBIF API 数据及其许可需按具体来源记录确认。该页面不抓取 GBIF 网站页面、不导入图片或分布事实。</p>
</div></section>
<%@ include file="../common/footer.jspf" %>
