<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<c:set var="adminSection" value="users"/>
<div class="admin-workspace">
  <%@ include file="../common/admin-sidebar.jspf" %>
  <div class="admin-content"><section class="page-intro admin-intro"><p class="eyebrow">CURATION DESK / ACCOUNTS</p><h1>用户管理</h1><p>检查普通账户并按需启用或停用；管理员账户不可从此页面停用。</p></section><c:choose><c:when test="${empty users}"><div class="empty-state"><h3>暂无账户记录</h3></div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>用户名</th><th>显示名称</th><th>邮箱</th><th>角色</th><th>状态</th><th>创建时间</th><th></th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td><b><c:out value="${u.username}"/></b></td><td><c:out value="${u.displayName}"/></td><td><c:out value="${u.email}" default="—"/></td><td><c:out value="${u.role}"/></td><td><span class="status-pill"><c:choose><c:when test="${u.enabled}">启用</c:when><c:otherwise>停用</c:otherwise></c:choose></span></td><td><c:out value="${u.createdAt}" default="—"/></td><td><c:if test="${not u.admin}"><form method="post" action="${pageContext.request.contextPath}/admin/users"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${u.id}"><input type="hidden" name="enabled" value="${not u.enabled}"><button class="link-button" type="submit"><c:choose><c:when test="${u.enabled}">停用</c:when><c:otherwise>启用</c:otherwise></c:choose></button></form></c:if></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
</div>
<%@ include file="../common/footer.jspf" %>
