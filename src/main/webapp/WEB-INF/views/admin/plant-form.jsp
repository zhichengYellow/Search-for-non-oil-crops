<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../common/header.jspf" %>
<c:set var="adminSection" value="plants"/>
<div class="admin-workspace">
  <%@ include file="../common/admin-sidebar.jspf" %>
  <div class="admin-content">
<section class="page-intro compact"><p class="eyebrow">CURATION DESK / PLANT RECORD</p><h1><c:choose><c:when test="${not empty plant}">编辑植物</c:when><c:otherwise>新增植物</c:otherwise></c:choose></h1><p>只录入能追溯到来源的内容；不确定字段留空并标记待核验。</p></section>
<form class="editor-form" method="post" action="${pageContext.request.contextPath}/admin/plants/save" data-validate="plant" novalidate>
  <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><c:if test="${not empty plant}"><input type="hidden" name="id" value="${plant.id}"></c:if>
  <div class="editor-section"><div><p class="eyebrow">01 / IDENTITY</p><h2>植物身份信息</h2></div><div class="editor-fields">
    <label>中文名称 <b>*</b><input name="nameZh" value="<c:out value='${plant.nameZh}'/>" maxlength="160" required></label>
    <label>拉丁学名<input name="scientificName" value="<c:out value='${plant.scientificName}'/>" maxlength="220"></label>
    <label>英文名称<input name="nameEn" value="<c:out value='${plant.nameEn}'/>" maxlength="160"></label>
    <label>所属属<select name="genusId"><option value="">未知 / 未录入</option><c:forEach items="${genera}" var="g"><option value="${g[0]}" <c:if test="${plant.genusId eq g[0]}">selected</c:if>><c:out value="${g[1]}"/></option></c:forEach></select><small>科信息由属记录继承；先在科属管理中维护分类。</small></label>
    <label>核验状态<select name="verificationStatus"><option value="NEEDS_REVIEW" <c:if test="${empty plant or plant.verificationStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="UNVERIFIED" <c:if test="${plant.verificationStatus eq 'UNVERIFIED'}">selected</c:if>>未核验</option><option value="VERIFIED" <c:if test="${plant.verificationStatus eq 'VERIFIED'}">selected</c:if>>已核验</option></select></label>
    <label>来源页码<input name="sourcePages" value="<c:out value='${plant.sourcePages}'/>" maxlength="80" placeholder="如：3–4；以原 PDF 页码为准"></label>
  </div></div>
  <div class="editor-section"><div><p class="eyebrow">02 / BOTANY</p><h2>植物学信息</h2></div><div class="editor-fields">
    <label class="full">形态特征<textarea name="morphology" maxlength="10000" rows="4"><c:out value="${plant.morphology}"/></textarea></label>
    <label class="full">地理分布<textarea name="distribution" maxlength="10000" rows="3"><c:out value="${plant.distribution}"/></textarea></label>
    <label class="full">栽培信息<textarea name="cultivation" maxlength="10000" rows="3"><c:out value="${plant.cultivation}"/></textarea></label>
    <label class="full">主要用途<textarea name="uses" maxlength="10000" rows="3"><c:out value="${plant.uses}"/></textarea></label>
  </div></div>
  <div class="editor-section"><div><p class="eyebrow">03 / SAMPLE</p><h2>新增采样记录</h2></div><div class="editor-fields">
    <p class="full muted">保存时新增一个独立样本；每行脂肪酸按“名称=百分比”填写。未知值不要填估算数值。</p>
    <label>样本名称<input name="sampleLabel" value="<c:out value='${sampleLabel}'/>" maxlength="120" placeholder="可留空"></label>
    <label>含油率（%）<input name="oilContent" type="number" min="0" max="100" step="0.001" value="<c:out value='${oilContent}'/>" placeholder="0–100"></label>
    <label>含油率核验状态<select name="oilContentStatus"><option value="NEEDS_REVIEW" <c:if test="${empty oilContentStatus or oilContentStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="VERIFIED" <c:if test="${oilContentStatus eq 'VERIFIED'}">selected</c:if>>已核验</option><option value="MISSING_OR_UNREADABLE" <c:if test="${oilContentStatus eq 'MISSING_OR_UNREADABLE'}">selected</c:if>>缺失或无法识别</option></select></label>
    <label>样本来源页码<input name="samplePages" value="<c:out value='${samplePages}'/>" maxlength="80"></label>
    <label>来源说明<input name="sampleNote" value="<c:out value='${sampleNote}'/>" maxlength="300"></label>
    <label>采样记录核验状态<select name="sampleVerificationStatus"><option value="NEEDS_REVIEW" <c:if test="${empty sampleVerificationStatus or sampleVerificationStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="UNVERIFIED" <c:if test="${sampleVerificationStatus eq 'UNVERIFIED'}">selected</c:if>>未核验</option><option value="VERIFIED" <c:if test="${sampleVerificationStatus eq 'VERIFIED'}">selected</c:if>>已核验</option></select></label>
    <label>脂肪酸组分核验状态<select name="componentVerificationStatus"><option value="NEEDS_REVIEW" <c:if test="${empty componentVerificationStatus or componentVerificationStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="UNVERIFIED" <c:if test="${componentVerificationStatus eq 'UNVERIFIED'}">selected</c:if>>未核验</option><option value="VERIFIED" <c:if test="${componentVerificationStatus eq 'VERIFIED'}">selected</c:if>>已核验</option></select></label>
    <label class="full">脂肪酸组成<textarea name="components" rows="5" placeholder="油酸=32.500&#10;亚油酸=18.200"><c:out value="${components}"/></textarea><small>组分录入默认标记为待核验；核验状态与含油率分别维护。</small></label>
  </div></div>
  <div class="editor-actions"><a class="button secondary" href="${pageContext.request.contextPath}/admin/plants">返回列表</a><button class="button primary" type="submit">保存植物资料 <span>→</span></button></div>
</form>
<c:if test="${not empty plant}">
  <section class="editor-section media-section"><div><p class="eyebrow">04 / IMAGE</p><h2>植物图片</h2></div><div class="editor-fields">
    <c:forEach items="${images}" var="img"><div class="image-admin-row"><img src="${pageContext.request.contextPath}/image/${img[1]}" alt="<c:out value='${img[2]}'/>"><div><b><c:out value="${img[2]}" default="未填写替代文本"/></b><small><c:out value="${img[3]}" default="未填写来源说明"/> · <c:if test="${img[4] eq '1'}">当前主图</c:if></small></div><form method="post" action="${pageContext.request.contextPath}/admin/plants/image/delete" data-confirm="删除这张植物图片？"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="plantId" value="${plant.id}"><input type="hidden" name="imageId" value="${img[0]}"><button class="link-button danger-text" type="submit">删除</button></form></div></c:forEach>
    <form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/admin/plants/image" class="stack-form upload-form" data-validate="upload" novalidate><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="plantId" value="${plant.id}"><label for="plant-image-upload">选择图片</label><input id="plant-image-upload" type="file" name="image" accept="image/jpeg,image/png,image/webp" required aria-describedby="image-upload-help"><small id="image-upload-help">JPG、PNG、WebP，最大 5 MB；请确认图片与该植物对应。</small><div class="upload-preview" data-upload-preview hidden><img alt="待上传图片预览"><p>本地预览；提交后才会保存。</p></div><label for="image-alt-text">替代文本</label><input id="image-alt-text" name="altText" maxlength="200"><label for="image-source-note">图片来源说明</label><input id="image-source-note" name="sourceNote" maxlength="300"><p class="form-validation-message" role="alert" aria-live="assertive" hidden></p><button class="button secondary" type="submit" data-loading-text="正在上传…">上传并设为主图</button></form>
  </div></section>
  <section class="editor-section sample-admin-section"><div><p class="eyebrow">05 / SAMPLES</p><h2>管理采样记录</h2></div><div class="editor-fields">
    <c:forEach items="${plant.samples}" var="sample"><article class="sample-edit-card"><form method="post" action="${pageContext.request.contextPath}/admin/plants/sample/save" class="sample-edit-form" data-validate="sample" novalidate><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="plantId" value="${plant.id}"><input type="hidden" name="sampleId" value="${sample.id}"><div class="sample-edit-heading"><b><c:out value="${sample.label}" default="未命名样本"/></b><span class="status-pill"><c:out value="${sample.verificationStatus}"/></span></div><div class="editor-fields"><label>样本名称<input name="sampleLabel" value="<c:out value='${sample.label}'/>" maxlength="120"></label><label>含油率（%）<input name="oilContent" type="number" min="0" max="100" step="0.001" value="<c:out value='${sample.oilContentPct}'/>"></label><label>含油率核验状态<select name="oilContentStatus"><option value="NEEDS_REVIEW" <c:if test="${sample.oilContentStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="VERIFIED" <c:if test="${sample.oilContentStatus eq 'VERIFIED'}">selected</c:if>>已核验</option><option value="MISSING_OR_UNREADABLE" <c:if test="${sample.oilContentStatus eq 'MISSING_OR_UNREADABLE'}">selected</c:if>>缺失或无法识别</option></select></label><label>来源页码<input name="samplePages" value="<c:out value='${sample.sourcePages}'/>" maxlength="80"></label><label>来源说明<input name="sampleNote" value="<c:out value='${sample.sourceNote}'/>" maxlength="300"></label><label>采样记录核验状态<select name="verificationStatus"><option value="NEEDS_REVIEW" <c:if test="${sample.verificationStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="UNVERIFIED" <c:if test="${sample.verificationStatus eq 'UNVERIFIED'}">selected</c:if>>未核验</option><option value="VERIFIED" <c:if test="${sample.verificationStatus eq 'VERIFIED'}">selected</c:if>>已核验</option></select></label><label>组分批量核验状态<select name="componentVerificationStatus"><option value="NEEDS_REVIEW" <c:if test="${empty sample.components or sample.components[0].verificationStatus eq 'NEEDS_REVIEW'}">selected</c:if>>待核验</option><option value="UNVERIFIED" <c:if test="${not empty sample.components and sample.components[0].verificationStatus eq 'UNVERIFIED'}">selected</c:if>>未核验</option><option value="VERIFIED" <c:if test="${not empty sample.components and sample.components[0].verificationStatus eq 'VERIFIED'}">selected</c:if>>已核验</option></select></label><label class="full">脂肪酸组成<textarea name="components" rows="4"><c:forEach items="${sample.components}" var="acid"><c:out value="${acid.name}"/>=<c:out value="${acid.percentage}"/>
</c:forEach></textarea><small>每行格式：名称=百分比（不要输入百分号）。此状态会应用于下方全部组分。</small></label></div><button class="button secondary" type="submit">保存采样记录与组分</button></form><form method="post" action="${pageContext.request.contextPath}/admin/plants/sample/delete" data-confirm="删除此样本及其所有组分？"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="plantId" value="${plant.id}"><input type="hidden" name="sampleId" value="${sample.id}"><button class="link-button danger-text" type="submit">删除样本</button></form></article></c:forEach>
  </div></section>
  <section class="editor-section"><div><p class="eyebrow">06 / ALIASES</p><h2>管理别名</h2></div><div class="editor-fields"><c:forEach items="${aliases}" var="a"><div class="existing-row"><span><c:out value="${a[1]}"/> · <c:out value="${a[2]}"/></span><form method="post" action="${pageContext.request.contextPath}/admin/plants/alias" data-confirm="确认移除这个别名？"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="plantId" value="${plant.id}"><input type="hidden" name="aliasId" value="${a[0]}"><input type="hidden" name="action" value="remove"><button class="link-button danger-text" type="submit">移除</button></form></div></c:forEach><form method="post" action="${pageContext.request.contextPath}/admin/plants/alias" class="alias-add"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="plantId" value="${plant.id}"><label class="sr-only" for="new-alias">新增别名</label><input id="new-alias" name="alias" maxlength="160" placeholder="新增别名" required><label class="sr-only" for="alias-language">别名语言</label><select id="alias-language" name="language"><option value="zh">中文</option><option value="en">英文</option><option value="other">其他</option></select><button class="button secondary" type="submit">添加别名</button></form></div></section>
</c:if>
</div>
</div>
<%@ include file="../common/footer.jspf" %>
