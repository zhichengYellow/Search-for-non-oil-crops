<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ include file="../common/header.jspf" %>
<section class="admin-workspace">
  <%@ include file="../common/admin-sidebar.jspf" %>
  <div class="admin-content">
    <section class="page-intro admin-intro"><p class="eyebrow">TRAIT ONTOLOGY / PROVENANCE</p><h1>外观特征与来源</h1><p>外观事实必须关联植物和来源。仅将有可核验证据的记录标为“已确认”；空缺、争议和待核验数据不会参与匹配。</p></section>
    <c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
    <section class="inner-panel trait-admin-form"><div class="section-heading"><div><p class="eyebrow">EVIDENCE RECORD</p><h2><c:choose><c:when test="${not empty editingValue}">编辑特征证据</c:when><c:otherwise>添加植物特征</c:otherwise></c:choose></h2></div></div>
      <c:if test="${not empty editingValue.evidenceImageReference}"><c:url var="traitEvidenceUrl" value="/admin/evidence"><c:param name="path" value="${editingValue.evidenceImageReference}"/></c:url><figure class="fatty-evidence"><a href="${traitEvidenceUrl}" target="_blank" rel="noopener"><img src="${traitEvidenceUrl}" alt="特征原始资料裁切"/></a><figcaption>原始资料裁切。确认特征前请核对原图，自动提取候选不得直接当作确认事实。</figcaption></figure></c:if>
      <form method="post" action="${pageContext.request.contextPath}/admin/traits" class="editor-fields trait-admin-fields" data-validate="trait-record" novalidate>
        <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${editingValue.id}">
        <label for="trait-plant">植物</label><select id="trait-plant" name="plantId" required><option value="">选择植物</option><c:forEach items="${plants}" var="plant"><option value="${plant.id}" <c:if test="${editingValue.plantId eq plant.id}">selected</c:if>><c:out value="${plant.nameZh}"/> — <c:out value="${plant.scientificName}" default="学名待核验"/></option></c:forEach></select>
        <label for="trait-definition">特征</label><select id="trait-definition" name="traitCode" required data-trait-option-filter><option value="">选择特征</option><c:forEach items="${traits}" var="trait"><option value="${trait.code}" <c:if test="${editingValue.traitCode eq trait.code}">selected</c:if>><c:out value="${trait.label}"/></option></c:forEach></select>
        <label for="trait-option">特征值</label><select id="trait-option" name="optionCode" required><option value="">选择特征值</option><c:forEach items="${traits}" var="trait"><c:forEach items="${trait.options}" var="option"><option data-trait-code="${trait.code}" value="${option.code}" <c:if test="${editingValue.traitCode eq trait.code and editingValue.optionCode eq option.code}">selected</c:if>><c:out value="${trait.label}"/>：<c:out value="${option.label}"/></option></c:forEach></c:forEach></select>
        <label for="trait-source">来源</label><select id="trait-source" name="sourceId" required><option value="">选择来源</option><c:forEach items="${sources}" var="source"><option value="${source.id}" <c:if test="${editingValue.sourceId eq source.id}">selected</c:if>><c:out value="${source.sourceName}"/> · <c:out value="${source.verificationStatus}"/></option></c:forEach></select>
        <label for="trait-page">来源页码或章节</label><input id="trait-page" name="sourcePage" maxlength="80" value="<c:out value='${editingValue.sourcePage}'/>" placeholder="例如：PDF 第 4 页">
        <label for="trait-status">事实核验状态</label><select id="trait-status" name="status" required><c:forEach items="${traitStatuses}" var="status"><option value="${status}" <c:if test="${empty editingValue and status eq 'NEEDS_REVIEW' or editingValue.status eq status}">selected</c:if>><c:choose><c:when test="${status eq 'CONFIRMED'}">已确认</c:when><c:when test="${status eq 'EXTRACTED'}">自动提取</c:when><c:when test="${status eq 'REVIEW_PENDING'}">待人工核验</c:when><c:when test="${status eq 'NEEDS_REVIEW'}">待核验</c:when><c:when test="${status eq 'UNKNOWN'}">未知</c:when><c:when test="${status eq 'REJECTED'}">已拒绝</c:when><c:otherwise>存在争议</c:otherwise></c:choose></option></c:forEach></select>
        <label for="trait-excerpt">原文片段或核验说明</label><textarea id="trait-excerpt" name="sourceExcerpt" rows="3" maxlength="4000" placeholder="保留支持该特征的原文、数据记录或人工核验说明"><c:out value="${editingValue.excerpt}"/></textarea>
        <p class="field-hint">仅“已确认”记录进入外观匹配；课程 PDF 中未明确记载的性状不要推测填写。</p>
        <div class="editor-actions"><button class="button primary" type="submit"><c:choose><c:when test="${not empty editingValue}">保存修改</c:when><c:otherwise>添加记录</c:otherwise></c:choose></button><c:if test="${not empty editingValue}"><a class="button secondary" href="${pageContext.request.contextPath}/admin/traits">取消编辑</a></c:if></div>
      </form>
    </section>

    <section class="inner-panel source-admin-form"><div class="section-heading"><div><p class="eyebrow">SOURCE CATALOG</p><h2>登记外部来源</h2></div></div><p class="muted">新增来源默认为“待核验”。请保留具体引用和许可，之后再为植物记录关联事实。</p>
      <form method="post" action="${pageContext.request.contextPath}/admin/traits" class="editor-fields source-fields" data-validate="trait-source" novalidate><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="source"><label for="source-name">来源名称</label><input id="source-name" name="sourceName" maxlength="240" required><label for="source-url">来源链接</label><input id="source-url" name="sourceUrl" type="url" maxlength="1000" placeholder="https://"><label for="source-citation">引用或文献</label><textarea id="source-citation" name="citation" maxlength="4000" rows="2"></textarea><label for="source-license">许可标识</label><input id="source-license" name="licenseCode" maxlength="80" placeholder="例如 CC BY 4.0；不清楚时注明 UNKNOWN"><div class="editor-actions"><button class="button secondary" type="submit">登记来源</button></div></form>
    </section>

    <section class="inner-panel trait-values-list"><div class="admin-table-heading"><p><b><c:out value="${fn:length(traitValues)}"/></b> 条特征证据（最多显示 150 条，自动提取仍需人工核验）</p></div><div class="table-wrap"><table class="data-table"><thead><tr><th>植物</th><th>特征与来源页</th><th>原图证据</th><th>核验状态</th><th>操作</th></tr></thead><tbody><c:forEach items="${traitValues}" var="value"><tr><td><c:out value="${value.plantName}"/></td><td><c:out value="${value.traitLabel}"/>：<c:out value="${value.optionLabel}" default="文本记录"/><c:if test="${not empty value.sourcePage}"><small> · <c:out value="${value.sourcePage}"/></small></c:if><c:if test="${not empty value.excerpt}"><small class="wrap-cell"><c:out value="${value.excerpt}"/></small></c:if></td><td><c:if test="${not empty value.evidenceImageReference}"><c:url var="traitRowEvidenceUrl" value="/admin/evidence"><c:param name="path" value="${value.evidenceImageReference}"/></c:url><a href="${traitRowEvidenceUrl}" target="_blank" rel="noopener"><img class="evidence-thumb" src="${traitRowEvidenceUrl}" alt="来源文字裁切" loading="lazy"/></a><small><c:out value="${value.extractionMethod}"/> · <c:out value="${value.mappingConfidence}"/></small></c:if><c:out value="${value.ambiguityNote}"/></td><td><span class="table-status"><c:out value="${value.status}"/></span></td><td class="admin-row-actions"><a class="button secondary" href="${pageContext.request.contextPath}/admin/traits?edit=${value.id}">编辑</a><form method="post" action="${pageContext.request.contextPath}/admin/traits" onsubmit="return confirm('确定删除该特征证据？');"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${value.id}"><button class="button danger" type="submit">删除</button></form></td></tr></c:forEach><c:if test="${empty traitValues}"><tr><td colspan="5">当前没有植物外观特征记录。添加记录时请填写来源证据。</td></tr></c:if></tbody></table></div></section>
  </div>
</section>
<%@ include file="../common/footer.jspf" %>
