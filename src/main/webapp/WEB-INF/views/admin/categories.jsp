<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<c:set var="adminSection" value="categories"/>
<div class="admin-workspace">
  <%@ include file="../common/admin-sidebar.jspf" %>
  <div class="admin-content"><section class="page-intro admin-intro"><p class="eyebrow">CURATION DESK / TAXONOMY</p><h1>科属管理</h1><p>先录入科，再维护对应的属；删除操作会检查是否存在关联记录。</p></section><div class="category-layout"><section class="form-panel inner-panel"><p class="eyebrow">FAMILY</p><h2>新增科</h2><form method="post" class="stack-form"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="family"><label>中文科名 <b>*</b><input name="familyZh" maxlength="100" required></label><label>拉丁科名<input name="familyLatin" maxlength="160"></label><button class="button primary" type="submit">添加科</button></form></section><section class="form-panel inner-panel"><p class="eyebrow">GENUS</p><h2>新增属</h2><form method="post" class="stack-form"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="genus"><label>所属科 <select name="familyId" required><option value="">选择科</option><c:forEach items="${families}" var="f"><option value="${f[0]}"><c:out value="${f[1]}"/></option></c:forEach></select></label><label>中文属名<input name="genusZh" maxlength="100"></label><label>拉丁属名 <b>*</b><input name="genusLatin" maxlength="120" required></label><button class="button primary" type="submit">添加属</button></form></section></div><section class="section-block"><div class="section-heading"><div><p class="eyebrow">FAMILY</p><h2>已录入科</h2></div></div><c:choose><c:when test="${empty families}"><div class="empty-inline">暂未录入科信息</div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>中文科名</th><th></th></tr></thead><tbody><c:forEach items="${families}" var="f"><tr><td><c:out value="${f[1]}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin/categories" data-confirm="仅无关联属的科可以删除。确认删除？"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="deleteFamily"><input type="hidden" name="id" value="${f[0]}"><button class="link-button danger-text" type="submit">删除</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section><section class="section-block"><div class="section-heading"><div><p class="eyebrow">GENUS</p><h2>已录入属</h2></div></div><c:choose><c:when test="${empty genera}"><div class="empty-inline">暂未录入属信息</div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>中文 / 拉丁属名及所属科</th><th></th></tr></thead><tbody><c:forEach items="${genera}" var="g"><tr><td><c:out value="${g[1]}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin/categories" data-confirm="仅未被植物使用的属可以删除。确认删除？"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="deleteGenus"><input type="hidden" name="id" value="${g[0]}"><button class="link-button danger-text" type="submit">删除</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></div>
</div>
<%@ include file="../common/footer.jspf" %>
